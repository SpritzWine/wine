MODULE    = localspl.dll
UNIXLIB   = localspl.so
IMPORTS   = spoolss user32 advapi32
UNIX_CFLAGS  = $(CUPS_CFLAGS)
# The PORTAL: port delivers through the Rust portal client shared with comdlg32
# (libwine_comdlg32.so): one copy in the process, so the dialog's token is
# still in memory when the job is spooled.
UNIX_LIBS    = $(APPLICATIONSERVICES_LIBS) $(WINE_RUST_LDFLAGS) -Wl,-lwine_comdlg32

EXTRADLLFLAGS = -Wb,--prefer-native

VER_FILEDESCRIPTION_STR = "Wine Printer spooler component"
VER_PRODUCTVERSION      = 5,1,2600,2180

SOURCES = \
	cups.c \
	localmon.c \
	localspl.rc \
	provider.c
