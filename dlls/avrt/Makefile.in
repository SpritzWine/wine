MODULE    = avrt.dll
IMPORTLIB = avrt
IMPORTS   = user32

# MMCSS (AvSetMmThreadCharacteristics & friends) is implemented in Rust: link the
# no_std PE staticlib libwine_avrt_pe.a (rust/src_dll/avrt_pe) and force its anchor
# so every export is pulled in -- same scheme as ntdll's libwine_ntdll_pe.a. The
# Get/SetThreadPriority/SetLastError it calls come from kernel32, auto-linked into
# every PE dll, so IMPORTS needs no change.
EXTRADLLFLAGS = -Wb,--prefer-native
i386_EXTRADLLFLAGS = $(WINE_RUST_AVRT_PE_LDFLAGS_i386)
x86_64_EXTRADLLFLAGS = $(WINE_RUST_AVRT_PE_LDFLAGS_x86_64)

SOURCES = \
	main.c
